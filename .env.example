OPENAI_API_KEY=sk-...
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: <app url>/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string; changing it signs everyone out
JWT_SECRET=
# Web Push keys (P-256, base64url). Generate once; changing them breaks existing push subscriptions
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
